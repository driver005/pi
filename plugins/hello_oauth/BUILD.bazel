    name = "hello_oauth",
    srcs = ["hello_oauth.cpp"],
    linkshared = True,
    deps = [
        "//sdk:pi_plugin_abi",
        "//sdk:pi_plugin_sdk",
        "//third_party:json",
    ],
    visibility = ["//visibility:public"],
)
